# =============================================================================
# TaxIDVerify — Environment Variables
# Copy this file to .env and fill in your values.
# =============================================================================

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
PORT=3000
LOG_LEVEL=info           # pino log level: trace | debug | info | warn | error

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Path to the SQLite database file. Directory is created automatically.
# Use :memory: for ephemeral / test runs.
DATABASE_PATH=./data/taxidverify.db

# ---------------------------------------------------------------------------
# Stripe  (required for Pro / Enterprise tier upgrades)
# ---------------------------------------------------------------------------
# Secret key from your Stripe dashboard (sk_live_... or sk_test_...).
STRIPE_SECRET_KEY=sk_test_...

# Webhook signing secret from the Stripe dashboard (Webhooks → your endpoint).
# The webhook endpoint is POST /v1/webhooks/stripe.
STRIPE_WEBHOOK_SECRET=whsec_...

# Optional: pre-created Price IDs for recurring subscriptions.
# If omitted, inline price_data is used (good for development / testing).
STRIPE_PRICE_BUSINESS=price_...
STRIPE_PRICE_PRO=price_...
STRIPE_PRICE_ENTERPRISE=price_...

# Annual billing Price IDs (20% discount applied automatically if omitted)
STRIPE_PRICE_BUSINESS_ANNUAL=price_...
STRIPE_PRICE_PRO_ANNUAL=price_...
STRIPE_PRICE_ENTERPRISE_ANNUAL=price_...

# ---------------------------------------------------------------------------
# Registry lookups
# ---------------------------------------------------------------------------
# Set VIES_ENABLED=false to skip real VIES SOAP calls and use simulation.
# Useful for development / CI where outbound calls are blocked.
VIES_ENABLED=true

# Simulated registry delay range (milliseconds). Ignored when VIES is active.
REGISTRY_MIN_DELAY=100
REGISTRY_MAX_DELAY=900

# ---------------------------------------------------------------------------
# Monitoring
# ---------------------------------------------------------------------------
# Secret key required in the X-Metrics-Api-Key header to access GET /metrics.
# If unset, the /metrics endpoint returns 503.
# Generate with: openssl rand -hex 32
METRICS_API_KEY=
